# Copy to .env and configure SECRET_KEY before starting the backend.

# Generate a unique random value of at least 32 characters.
SECRET_KEY=

# Database. SQLite by default; swap for Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/jobquest
DATABASE_URL=sqlite:///./jobquest.db

# AI provider: auto | ollama | gemini | local
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Google ADK / Gemini fallback (keep key private).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Auto-apply behaviour: "demo" simulates submissions (safe, default).
# "live" drives real forms with Playwright — only where you're permitted.
APPLY_MODE=demo

# Job source: "seed" uses the built-in sample feed; "live" uses the scraper.
JOB_SOURCE=seed
